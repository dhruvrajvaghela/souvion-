# Discord
DISCORD_TOKEN=your_bot_token_here
GUILD_ID=0
OWNER_IDS=123456789012345678,987654321098765432
ADMIN_ROLE_ID=0
STAFF_ROLE_IDS=
PAYMENT_CATEGORY_ID=0

# Data (Railway persistent volume recommended)
DATA_DIR=./data
DB_PATH=./data/atlanta_esports.db

# Payment - QR / UPI
UPI_ID=
UPI_NAME=Atlanta Esports

# Razorpay (optional – leave empty to disable gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Webhook server (for Razorpay on Railway)
WEBHOOK_PORT=8080
WEBHOOK_HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-app.up.railway.app
