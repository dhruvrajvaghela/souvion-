# Copy to .env for local use. On Railway, set these in the Variables tab instead.

# Bot token from https://discord.com/developers/applications (never commit the real value)
DISCORD_TOKEN=

# ID of the role that may manage lobbies and approve payments
ADMIN_ROLE_ID=

# Category ID where private payment channels are created (leave empty for no category)
PAYMENT_CATEGORY_ID=

# Persistent storage (Railway volume mounted at /data)
DATA_DIR=/data
DB_PATH=/data/atlanta_esports.db

# Optional: your server ID, makes slash commands appear instantly
GUILD_ID=
